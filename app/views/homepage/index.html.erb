<section class="slab">
  <div class="grid">
    <div class="grid__item width-one-sixth">
      <p class="spacing-below-0">&nbsp;</p>
    </div>
    <div class="grid__item width-two-thirds">
      <div class="card">
        <h1><%= t("views.homepage.index.title") %></h1>

        <p><%= t("views.homepage.index.title_help_text_html") %></p>
        <div class="notice yellow">
          <div class="media-box">
            <div class="media-box__media media--icon">
              <i class="icon-info_outline"></i>
            </div>
            <div class="media-box__content">
              <%= t("views.homepage.index.notice_text") %>
            </div>
          </div>
        </div>
        <p><strong><%= t("views.homepage.index.time_to_complete") %></strong></p>

        <%= link_to t("views.homepage.fill_out_form"), start_flow_path, class: "spacing-below-60 spacing-above-35 button button--primary" %>

        <div class="card-section--full-bleed teal">
          <h2><%= t("views.homepage.index.about_form.title") %></h2>

          <div class="notice white">
            <div class="media-box">
              <div class="media-box__media media--illustration">
                <%= image_tag "checkmark.svg", class: "illustration medium left-justified" %>
              </div>
              <div class="media-box__content">
                <h3><%= t("views.homepage.index.about_form.exempt_title") %></h3>
              </div>
            </div>
            <%= t("views.homepage.index.about_form.exempt_help_text") %>
          </div>

          <div class="notice white">
            <div class="media-box">
              <div class="media-box__media media--illustration">
                <%= image_tag "megaphone.svg", class: "illustration medium left-justified" %>
              </div>
              <div class="media-box__content">
                <h3><%= t("views.homepage.index.about_form.comply_title") %></h3>
              </div>
            </div>
            <%= t("views.homepage.index.about_form.comply_help_text") %>
          </div>

          <div class="notice white">
            <div class="media-box">
              <div class="media-box__media media--illustration">
                <%= image_tag "warning-sign.svg", class: "illustration medium left-justified" %>
              </div>
              <div class="media-box__content">
                <h3><%= t("views.homepage.index.about_form.unmet_title") %></h3>
              </div>
            </div>
            <%= t("views.homepage.index.about_form.unmet_help_text") %>
          </div>
        </div>

        <div class="spacing-above-35">
          <h2><%= t("views.homepage.index.how_it_works.title") %></h2>

          <ol class="numbered-steps">
            <li>
              <strong class="numbered-steps__title">
                <%= t("views.homepage.index.how_it_works.answer_questions_title") %>
              </strong>
              <p><%= t("views.homepage.index.how_it_works.answer_questions_help_text") %></p>
            </li>
            <hr class="tight"/>
            <li>
              <strong class="numbered-steps__title">
                <%= t("views.homepage.index.how_it_works.get_form_title") %>
              </strong>
              <p><%= t("views.homepage.index.how_it_works.get_form_help_text") %></p>
            </li>
            <hr class="tight"/>
            <li>
              <strong class="numbered-steps__title">
                <%= t("views.homepage.index.how_it_works.share_form_title") %>
              </strong>
              <p><%= t("views.homepage.index.how_it_works.share_form_help_text") %></p>
            </li>
            <hr class="tight"/>
          </ol>
        </div>

        <div class="card-section--full-bleed grey spacing-above-60">
          <h2><%= t("views.homepage.index.faq.title") %></h2>

          <div class="accordion">
            <button class="accordion__button" aria-expanded="true" data-track-click="faq_clicked" data-track-faq-name="snap-work-rules"><%= t("views.homepage.index.faq.work_rules") %></button>
            <div class="accordion__content">
              <%= t("views.homepage.index.faq.work_rules_content_html") %>
            </div>
          </div>
          <div class="accordion">
            <button class="accordion__button" aria-expanded="true" data-track-click="faq_clicked" data-track-faq-name="snap-rules-apply"><%= t("views.homepage.index.faq.who") %></button>
            <div class="accordion__content">
              <%= t("views.homepage.index.faq.who_content_html") %>
            </div>
          </div>
          <div class="accordion">
            <button class="accordion__button" aria-expanded="true" data-track-click="faq_clicked" data-track-faq-name="snap-rules-do-not-apply"><%= t("views.homepage.index.faq.who_not") %></button>
            <div class="accordion__content">
              <%= t("views.homepage.index.faq.who_not_content_html") %>
            </div>
          </div>
          <div class="accordion">
            <button class="accordion__button" aria-expanded="true" data-track-click="faq_clicked" data-track-faq-name="keep-snap"><%= t("views.homepage.index.faq.keep_snap") %></button>
            <div class="accordion__content">
              <%= t("views.homepage.index.faq.keep_snap_content_html") %>
            </div>
          </div>
          <div class="accordion">
            <button class="accordion__button" aria-expanded="true" data-track-click="faq_clicked" data-track-faq-name="preventing-work-exemption"><%= t("views.homepage.index.faq.cant_work") %></button>
            <div class="accordion__content">
              <%= t("views.homepage.index.faq.cant_work_content_html") %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
